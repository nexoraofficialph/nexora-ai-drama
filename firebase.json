{
  "hosting": {
    "public": "www",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "firebase/functions/**"
    ],
    "cleanUrls": true
  },
  "functions": {
    "source": "firebase/functions"
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  }
}
